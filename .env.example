# MELODIESPARK MVP - Environment Configuration (SENSITIVE)
# ==========================================================
# 1. Copy this file to .env and fill in your actual Stripe keys
# 2. Add .env to .gitignore NEVER commit real keys to version control!
# 3. Never share .env files publicly or in code repositories

# Stripe Keys - Get these from: https://dashboard.stripe.com/account/apkeys
# TEST MODE (recommended for start):
STRIPE_SECRET_KEY=sk_test_51XxxxxxxxxxxxxxxxxxxxxxxxxxYOUR_TEST_SECRET_HERE
STRIPE_PUBLIC_KEY=pk_test_51XxxxxxxxxxxxxxxxxxxxxxxxxxYOUR_TEST_PUBLIC_HERE
STRIPE_WEBHOOK_SECRET=whsec_51XxxxxxxxxxxxxxxxxxxxxxxxxxYOUR_WEBHOOK_SECRET

# When ready for live: Remove "test_" prefixes and use live keys
# LIVE MODE: STRIPE_SECRET_KEY=sk_live_...

# Database
DATABASE_URL=postgres://melodiespark_user:melodiespark_password@localhost:5432/melodiespark

# Security
JWT_SECRET=melodiespark-enterprise-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# WARNING: Keep these keys secret! 
# STRIPE_SECRET_KEY authorizes charged to your Stripe account
# JWT_SECRET signs user authentication tokens